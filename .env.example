# ─────────────────────────────────────────────
# Backend (copy to backend/.env or use appsettings)
# ─────────────────────────────────────────────
# ConnectionStrings__Default=Server=localhost;Database=PartZone;User Id=sa;Password=YourPassword;TrustServerCertificate=True
# Jwt__SecretKey=your-256-bit-secret-key-here-change-in-production
# Jwt__Issuer=https://partzone.localhost
# Jwt__Audience=partzone-clients
# Jwt__AccessTokenExpiryMinutes=60
# Jwt__RefreshTokenExpiryDays=30
# APPLY_MIGRATIONS=false

# ─────────────────────────────────────────────
# Storefront (Next.js) — copy to storefront/.env.local
# ─────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ─────────────────────────────────────────────
# Admin dashboard (Vite) — copy to admin-dashboard/.env.local
# ─────────────────────────────────────────────
# VITE_GRAPHQL_URL=http://localhost:5000/graphql
# VITE_API_URL=http://localhost:5000/api/v1
