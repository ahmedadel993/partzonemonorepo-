<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath=".\PartZone.Host.exe" arguments=".\PartZone.Host.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    <!-- SPA fallback for /admin — rewrite requests that don't match a file to /admin/index.html -->
    <rewrite>
      <rules>
        <rule name="Admin SPA Fallback" stopProcessing="true">
          <match url="^admin/(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/admin/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
