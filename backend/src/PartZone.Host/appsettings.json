{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Server=.;Database=PartZone;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_SECRET_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "https://partzone.localhost",
    "Audience": "partzone-clients",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "APPLY_MIGRATIONS": false,
  "AllowedHosts": "*"
}
